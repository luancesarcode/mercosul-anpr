# ANPR runtime configuration
ANPR_SOURCE=Videos_input/Test1.mp4
ANPR_COCO_MODEL=modelos/yolov8n.pt
ANPR_PLATE_MODEL=modelos/best.pt
ANPR_RUNS_DIR=runs/predict
ANPR_LOG_DIR=runs/logs

# Inference and detection
ANPR_IMG_SIZE=640
ANPR_VEHICLE_CONF=0.60
ANPR_VEHICLE_IOU=0.70
ANPR_VEHICLE_MIN_AREA_RATIO=0.002
ANPR_PLATE_CONF=0.01
ANPR_PLATE_RECALL_CONF=0.003
ANPR_PLATE_IOU=0.50
ANPR_MAX_PLATES=6

# Tracking and temporal vote
ANPR_TRACK_IOU=0.30
ANPR_TRACK_MIN_HITS=3
ANPR_TRACK_MAX_AGE=15
ANPR_PLATE_VOTE_WINDOW=10
ANPR_PLATE_SWITCH_DOMINANCE_FRAMES=3
ANPR_DEBUGGER_WINDOW_FRAMES=30
ANPR_PLATE_MIN_OCCURRENCES=2
ANPR_PLATE_MIN_SCORE=65.0
ANPR_OCR_INTERVAL_FRAMES=1

# Display filter and anti-jitter
ANPR_PLATE_TEXT_CONF_MIN=70.0
ANPR_PLATE_TEXT_CONF_MAX=100.0
ANPR_PLATE_BBOX_SMOOTH_ENABLED=true
ANPR_PLATE_BBOX_SMOOTH_ALPHA=0.35

# Association / ROI
ANPR_USE_ROI_DETECTION=true
ANPR_USE_HYBRID_ASSOCIATION=true
ANPR_ASSOCIATION_THRESHOLD=0.34
ANPR_ASSOC_WEIGHT_IOU=0.5
ANPR_ASSOC_WEIGHT_CENTER=0.3
ANPR_ASSOC_WEIGHT_SIZE=0.2
ANPR_ROI_CACHE_TTL=2

# Profiling
ANPR_ENABLE_CPROFILE=false
ANPR_ENABLE_LINE_PROFILER=false
